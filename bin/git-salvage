#!/usr/bin/env bash
# git-salvage -- snapshots uncommitted work before destructive git commands.
# Spec: docs/DESIGN.md. Must run on macOS /bin/bash 3.2: no associative
# arrays, no mapfile, and every "${arr[@]}" of a possibly-empty array is
# written ${arr[@]+"${arr[@]}"} because 3.2's `set -u` calls it unbound.
set -u

# Every git call below must reach the real git, not the shim.
export GIT_SALVAGE_ACTIVE=1
# The snapshot's identity is fixed so a missing user.name can never fail it.
SALVAGE_IDENT_NAME=git-salvage
SALVAGE_IDENT_EMAIL=git-salvage@localhost

PROG=git-salvage
REF_PREFIX=refs/salvage/

TMPFILES=()
cleanup() { [ ${#TMPFILES[@]} -gt 0 ] && rm -f "${TMPFILES[@]}"; return 0; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

err() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { err "$@"; exit 1; }

usage() {
	cat <<'EOF'
usage: git salvage list
       git salvage show <n> [--stat | -p]
       git salvage restore <n> [--index] [-- <path>...]
       git salvage snapshot [-m <message>]
       git salvage drop <n>
       git salvage prune [--keep <k>] [--older-than <days>]
       git salvage install [--dir <dir>] | uninstall [--dir <dir>] | doctor

Snapshots are numbered 1 = newest, in `git salvage list` order.
EOF
}

# ---------------------------------------------------------------- repo setup

# Sets GITDIR, TOP, INDEX. Returns 1 when not inside a work tree (or bare).
REPO_READY=0
repo_setup() {
	[ "$REPO_READY" = 1 ] && return 0
	GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null) || return 1
	[ "$(git rev-parse --is-bare-repository 2>/dev/null)" = true ] && return 1
	TOP=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
	INDEX=$(cd "$TOP" && git rev-parse --path-format=absolute --git-path index) || return 1
	REPO_READY=1
}

need_repo() {
	repo_setup || die "not inside a git work tree"
}

# Sets TMP_LAST. Not called through $(...): the TMPFILES registration would
# happen in a subshell and the file would outlive the run.
mktmp() {
	TMP_LAST=$(mktemp "$GITDIR/salvage-tmp.XXXXXX") || return 1
	TMPFILES+=("$TMP_LAST")
}

EMPTY_TREE=
empty_tree() {
	[ -n "$EMPTY_TREE" ] || EMPTY_TREE=$(git hash-object -w -t tree --stdin </dev/null)
	printf '%s\n' "$EMPTY_TREE"
}

head_commit() { git rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null; }

# ------------------------------------------------------------ snapshot store

# All snapshot refs, newest first, one per line.
list_refs() {
	git for-each-ref --sort=-refname --format='%(refname)' "$REF_PREFIX"
}

# Resolves user number N (1 = newest) to a ref name, or dies.
ref_for() {
	local n=$1 ref
	case $n in
	'' | *[!0-9]* | 0) die "not a snapshot number: '$n' (see: git salvage list)" ;;
	esac
	ref=$(list_refs | sed -n "${n}p")
	[ -n "$ref" ] || die "no snapshot $n (see: git salvage list)"
	printf '%s\n' "$ref"
}

trailer() { # <commit> <key>
	git log -1 --format="%(trailers:key=$2,valueonly,separator=%x2C)" "$1"
}

# <epoch>-<seq>-<pid>: seq is one past the newest same-second ref's, so the
# refname order is creation order even when pids wrap. The pid only keeps two
# concurrent processes that pick the same seq from colliding.
new_ref_name() {
	local now n name last
	now=$(printf '%010d' "$(date +%s)")
	last=$(git for-each-ref --sort=-refname --count=1 --format='%(refname)' "$REF_PREFIX$now-*")
	n=0
	if [ -n "$last" ]; then
		last=${last#"$REF_PREFIX$now-"}
		last=${last%%-*}
		case $last in '' | *[!0-9]*) ;; *) n=$((10#$last + 1)) ;; esac
	fi
	while :; do
		name=$(printf '%s%s-%06d-%010d' "$REF_PREFIX" "$now" "$n" "$$")
		git show-ref -q --verify "$name" || break
		n=$((n + 1))
	done
	printf '%s\n' "$name"
}

# make_commit <tree> <message> [<parent>...] -> prints commit id
make_commit() {
	local tree=$1 msg=$2
	shift 2
	local args=() p
	for p in "$@"; do args+=(-p "$p"); done
	printf '%s\n' "$msg" |
		GIT_AUTHOR_NAME=$SALVAGE_IDENT_NAME GIT_AUTHOR_EMAIL=$SALVAGE_IDENT_EMAIL \
			GIT_COMMITTER_NAME=$SALVAGE_IDENT_NAME GIT_COMMITTER_EMAIL=$SALVAGE_IDENT_EMAIL \
			git commit-tree --no-gpg-sign "$tree" ${args[@]+"${args[@]}"}
}

store() { # <commit> -> creates a new ref, prints nothing
	local ref
	ref=$(new_ref_name)
	git update-ref -m "git-salvage" "$ref" "$1" "" || return 1
}

retention() {
	local keep
	keep=$(git config --int salvage.keep 2>/dev/null) || keep=200
	case $keep in '' | *[!0-9]*) keep=200 ;; esac
	[ "$keep" -ge 1 ] || keep=1
	list_refs | sed -n "$((keep + 1)),\$p" | sed 's/^/delete /' | git update-ref --stdin
}

# Snapshot result, read by callers: SAVED=1 when a ref was created.
SAVED=0
SNAP_ERR=

# snapshot_worktree <message> <include-ignored 0|1> [<untracked-at-risk 0|1>]
# The snapshot always contains untracked files, but they only make it
# "worth saving" when the command can destroy them; otherwise every branch
# switch in a repo with an untracked file would print a new snapshot.
# Returns 0 on saved or nothing-to-save (SAVED tells which), 1 on failure
# with SNAP_ERR set.
snapshot_worktree() {
	local msg=$1 ignored=$2 untracked=${3:-1} tmp out tw ttr ti head htree index_state=captured
	local newest ntw nti tree commit sym
	SAVED=0
	mktmp || { SNAP_ERR="cannot create a temporary file in $GITDIR"; return 1; }
	tmp=$TMP_LAST

	# A 0-byte file is not an empty index (git: "index file smaller than
	# expected"), so a repo with no index yet starts from no file at all.
	if [ -f "$INDEX" ]; then
		cp "$INDEX" "$tmp" || { SNAP_ERR="cannot copy the index"; return 1; }
	else
		rm -f "$tmp"
	fi
	# Tracked changes only first, then everything.
	if ! out=$(cd "$TOP" && GIT_INDEX_FILE=$tmp git add -u 2>&1); then
		SNAP_ERR="git add failed: $(printf '%s' "$out" | head -n 3)"
		return 1
	fi
	if ! ttr=$(GIT_INDEX_FILE=$tmp git write-tree 2>/dev/null); then
		SNAP_ERR="git write-tree failed for the working tree"
		return 1
	fi
	local addflags=(-A)
	[ "$ignored" = 1 ] && addflags+=(-f)
	if ! out=$(cd "$TOP" && GIT_INDEX_FILE=$tmp git -c advice.addEmbeddedRepo=false \
		add "${addflags[@]}" 2>&1); then
		SNAP_ERR="git add failed: $(printf '%s' "$out" | head -n 3)"
		return 1
	fi
	if ! tw=$(GIT_INDEX_FILE=$tmp git write-tree 2>/dev/null); then
		SNAP_ERR="git write-tree failed for the working tree"
		return 1
	fi

	if [ -f "$INDEX" ]; then
		cp "$INDEX" "$tmp" || { SNAP_ERR="cannot copy the index"; return 1; }
		if ! ti=$(GIT_INDEX_FILE=$tmp git write-tree 2>/dev/null); then
			if [ -n "$(git ls-files -u | head -n 1)" ]; then
				ti=
				index_state=unmerged-not-captured
			else
				SNAP_ERR="git write-tree failed for the index"
				return 1
			fi
		fi
	else
		ti=$(empty_tree)
	fi

	head=$(head_commit) || head=
	if [ -n "$head" ]; then htree=$(git rev-parse "$head^{tree}"); else htree=$(empty_tree); fi
	# Nothing the command can destroy.
	if [ "$untracked" = 1 ]; then
		[ "$tw" = "$htree" ] && [ "$ti" = "$htree" ] && return 0
	else
		[ "$ttr" = "$htree" ] && [ "$ti" = "$htree" ] && return 0
	fi
	# Same state as the newest worktree snapshot: repeated command.
	newest=$(newest_worktree_ref)
	if [ -n "$newest" ]; then
		ntw=$(git rev-parse -q --verify "$newest:worktree" 2>/dev/null) || ntw=
		nti=$(git rev-parse -q --verify "$newest:index" 2>/dev/null) || nti=
		[ "$tw" = "$ntw" ] && [ "$ti" = "$nti" ] && return 0
	fi

	if [ -n "$ti" ]; then
		tree=$(printf '040000 tree %s\tindex\n040000 tree %s\tworktree\n' "$ti" "$tw" | git mktree)
	else
		tree=$(printf '040000 tree %s\tworktree\n' "$tw" | git mktree)
	fi || { SNAP_ERR="git mktree failed"; return 1; }
	sym=$(git symbolic-ref -q HEAD 2>/dev/null) || sym=detached
	msg=$(printf '%s\n\nSalvage-Kind: worktree\nSalvage-Head: %s\nSalvage-Index: %s' \
		"$msg" "$sym" "$index_state")
	if [ -n "$head" ]; then
		commit=$(make_commit "$tree" "$msg" "$head")
	else
		commit=$(make_commit "$tree" "$msg")
	fi || { SNAP_ERR="git commit-tree failed"; return 1; }
	store "$commit" || { SNAP_ERR="git update-ref failed"; return 1; }
	SAVED=1
}

newest_worktree_ref() {
	local r
	for r in $(list_refs); do
		if [ "$(trailer "$r" Salvage-Kind)" = worktree ]; then
			printf '%s\n' "$r"
			return 0
		fi
	done
}

# record_ref <kind branch|stash> <refname-label> <tip-commit> <message>
record_ref() {
	local kind=$1 label=$2 tip=$3 msg=$4 commit
	msg=$(printf '%s\n\nSalvage-Kind: %s\nSalvage-Ref: %s' "$msg" "$kind" "$label")
	commit=$(make_commit "$(empty_tree)" "$msg" "$tip") || { SNAP_ERR="git commit-tree failed"; return 1; }
	store "$commit" || { SNAP_ERR="git update-ref failed"; return 1; }
	SAVED=$((SAVED + 1))
}

# ------------------------------------------------------ _pre: classification

# Builtins that never destroy uncommitted work. Skipping the alias lookup for
# them keeps an IDE's status polling at zero extra processes.
SAFE_CMDS=" status log diff show add commit fetch push pull rev-parse ls-files
 ls-tree cat-file config remote tag describe blame grep shortlog rev-list
 for-each-ref show-ref symbolic-ref update-index diff-index diff-files
 diff-tree merge-base name-rev reflog init clone help version var hash-object
 check-ignore check-attr worktree submodule notes bisect format-patch apply
 mv gc fsck count-objects repack prune maintenance credential salvage "

# Destructive-capable commands: never alias-expanded (git ignores an alias
# that shadows a builtin, measured in dev/measure-premise.sh Q1).
TRIGGER_CMDS=" reset checkout restore switch clean rm merge rebase cherry-pick
 revert am stash branch "

# Short options that take an argument, per command: a cluster stops there.
short_arg_letters() {
	case $1 in
	clean) printf 'e' ;;
	switch) printf 'cC' ;;
	checkout) printf 'bB' ;;
	branch) printf 'u' ;; # -t takes no argument (git branch -h)
	*) printf '' ;;
	esac
}

# Fills OPTS (options before --) and ARGS (non-option words) from "$@",
# for command $CMD. Long options are kept whole (--x=y as is); short
# clusters are expanded into single letters.
split_args() {
	OPTS=()
	ARGS=()
	local a dd=0 argl c rest
	argl=$(short_arg_letters "$CMD")
	while [ $# -gt 0 ]; do
		a=$1
		shift
		if [ "$dd" = 1 ]; then ARGS+=("$a"); continue; fi
		case $a in
		--) dd=1 ;;
		--*) OPTS+=("$a") ;;
		-?*)
			rest=${a#-}
			while [ -n "$rest" ]; do
				c=${rest:0:1}
				rest=${rest:1}
				OPTS+=("-$c")
				case $argl in
				*"$c"*)
					# The argument is the rest of the cluster or the next word.
					if [ -z "$rest" ] && [ $# -gt 0 ]; then shift; fi
					rest=
					;;
				esac
			done
			;;
		*) ARGS+=("$a") ;;
		esac
	done
}

has_opt() { # has_opt <opt>... : any of them present in OPTS
	local o w
	for o in ${OPTS[@]+"${OPTS[@]}"}; do
		for w in "$@"; do
			case $o in
			"$w" | "$w"=*) return 0 ;;
			esac
		done
	done
	return 1
}

# Decides what to record for the triggering argv. Sets PRE_KIND to
# none|worktree|stash-drop|stash-clear|branch-delete|branch-move and
# PRE_IGNORED; leaves the command's own args in OPTS/ARGS.
classify() {
	PRE_KIND=none
	PRE_IGNORED=0
	PRE_UNTRACKED=0
	has_opt -h --help && return 0
	case $CMD in
	reset)
		has_opt --soft || PRE_KIND=worktree
		has_opt --hard && PRE_UNTRACKED=1
		;;
	checkout)
		PRE_KIND=worktree
		has_opt -f --force && PRE_UNTRACKED=1
		;;
	restore) PRE_KIND=worktree ;;
	switch)
		has_opt -f --force --discard-changes -m --merge && PRE_KIND=worktree
		has_opt -f --force --discard-changes && PRE_UNTRACKED=1
		;;
	clean)
		if ! has_opt -n --dry-run; then
			PRE_KIND=worktree
			PRE_UNTRACKED=1
			has_opt -x -X && PRE_IGNORED=1
		fi
		;;
	rm) has_opt -f --force && PRE_KIND=worktree ;;
	merge | rebase | cherry-pick | revert | am)
		has_opt --abort --skip && PRE_KIND=worktree
		;;
	stash)
		case ${ARGS[0]:-} in
		drop | pop) PRE_KIND=stash-drop ;;
		clear) PRE_KIND=stash-clear ;;
		esac
		;;
	branch)
		if has_opt -d -D --delete; then
			PRE_KIND=branch-delete
		elif has_opt -M -C; then
			PRE_KIND=branch-move
		elif has_opt -m -c --move --copy && has_opt -f --force; then
			# Without -f, -m/-c refuse an existing target (measured, exit 128).
			PRE_KIND=branch-move
		fi
		;;
	esac
	return 0
}

stash_spec() { # <word or empty> -> revision
	case ${1:-} in
	'') printf 'stash@{0}\n' ;;
	*[!0-9]*) printf '%s\n' "$1" ;;
	*) printf 'stash@{%s}\n' "$1" ;;
	esac
}

cmd_pre() {
	[ "${GIT_SALVAGE_SKIP:-}" = 1 ] && return 0
	[ $# -gt 0 ] || return 0
	local display="git $*"
	CMD=$1
	shift
	case $TRIGGER_CMDS in
	*" $CMD "*) ;;
	*)
		case $SAFE_CMDS in *" $CMD "*) return 0 ;; esac
		local alias_val
		alias_val=$(git config --get "alias.$CMD" 2>/dev/null) || return 0
		case $alias_val in '!'* | '') return 0 ;; esac
		set -f
		# shellcheck disable=SC2086 # word-splitting the alias is the point
		set -- $alias_val "$@"
		set +f
		CMD=$1
		shift
		;;
	esac
	split_args "$@"
	classify
	[ "$PRE_KIND" = none ] && return 0
	repo_setup || return 0

	SAVED=0
	SNAP_ERR=
	local ok=0 spec tip i name ref prefix
	case $PRE_KIND in
	worktree)
		snapshot_worktree "$display" "$PRE_IGNORED" "$PRE_UNTRACKED" || ok=1
		;;
	stash-drop)
		spec=$(stash_spec "${ARGS[1]:-}")
		if tip=$(git rev-parse -q --verify "$spec" 2>/dev/null); then
			record_ref stash "$spec" "$tip" "$display" || ok=1
		fi
		;;
	stash-clear)
		i=0
		for tip in $(git log -g --format=%H refs/stash 2>/dev/null); do
			record_ref stash "stash@{$i}" "$tip" "$display" || { ok=1; break; }
			i=$((i + 1))
		done
		;;
	branch-delete)
		prefix=refs/heads/
		has_opt -r --remotes && prefix=refs/remotes/
		for name in ${ARGS[@]+"${ARGS[@]}"}; do
			ref=$prefix$name
			if tip=$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null); then
				record_ref branch "$ref" "$tip" "$display" || { ok=1; break; }
			fi
		done
		;;
	branch-move)
		# <old> <new>, or <new> alone (old = current branch): only <new>'s
		# existing tip is at risk of being overwritten.
		name=
		[ ${#ARGS[@]} -ge 1 ] && name=${ARGS[${#ARGS[@]} - 1]}
		if [ -n "$name" ] && tip=$(git rev-parse -q --verify "refs/heads/$name^{commit}" 2>/dev/null); then
			record_ref branch "refs/heads/$name" "$tip" "$display" || ok=1
		fi
		;;
	esac

	if [ "$ok" != 0 ]; then
		err "could not save a snapshot (${SNAP_ERR:-unknown error}); '$display' was not run."
		err "set GIT_SALVAGE_SKIP=1 to run it without a snapshot."
		return 1
	fi
	if [ "$SAVED" -gt 0 ]; then
		retention
		if ! is_quiet; then
			if [ "$SAVED" = 1 ]; then
				err "saved snapshot 1 (undo with: git salvage restore 1)"
			else
				err "saved snapshots 1-$SAVED (see: git salvage list)"
			fi
		fi
	fi
	return 0
}

is_quiet() {
	[ "${GIT_SALVAGE_QUIET:-}" = 1 ] && return 0
	[ "$(git config --bool salvage.quiet 2>/dev/null)" = true ]
}

# -------------------------------------------------------------- user commands

cmd_list() {
	need_repo
	local n=0 ref kind subj when count base extra
	for ref in $(list_refs); do
		n=$((n + 1))
		kind=$(trailer "$ref" Salvage-Kind)
		subj=$(git log -1 --format=%s "$ref")
		when=$(git log -1 --date='format-local:%Y-%m-%d %H:%M:%S' --format=%cd "$ref")
		extra=
		case $kind in
		worktree)
			base=$(git rev-parse -q --verify "$ref^1^{tree}" 2>/dev/null) || base=$(empty_tree)
			count=$(git diff-tree -r --name-only "$base" "$ref:worktree" | wc -l | tr -d ' ')
			extra="  ($count paths)"
			;;
		*) extra="  ($(trailer "$ref" Salvage-Ref))" ;;
		esac
		printf '%3d  %s  %-8s  %s%s\n' "$n" "$when" "$kind" "$subj" "$extra"
	done
	[ "$n" = 0 ] && echo "no snapshots"
	return 0
}

cmd_show() {
	need_repo
	[ $# -ge 1 ] || die "usage: git salvage show <n> [--stat | -p]"
	local ref kind mode=--stat base
	ref=$(ref_for "$1") || exit 1
	shift
	case ${1:-} in
	'' | --stat) mode=--stat ;;
	-p | --patch) mode=-p ;;
	*) die "usage: git salvage show <n> [--stat | -p]" ;;
	esac
	kind=$(trailer "$ref" Salvage-Kind)
	git --no-pager log -1 --date=iso --format='snapshot %H%nDate:    %cd%n%n    %B' "$ref"
	case $kind in
	worktree)
		base=$(git rev-parse -q --verify "$ref^1" 2>/dev/null) || base=$(empty_tree)
		git --no-pager diff "$mode" "$base" "$ref:worktree"
		;;
	*)
		git --no-pager log -1 --format='saved commit: %H %s' "$ref^1"
		;;
	esac
}

cmd_restore() {
	need_repo
	local n='' with_index=0 paths=() a
	while [ $# -gt 0 ]; do
		a=$1
		shift
		case $a in
		--index) with_index=1 ;;
		--)
			paths=("$@")
			break
			;;
		-*) die "unknown option: $a" ;;
		*)
			[ -z "$n" ] || die "usage: git salvage restore <n> [--index] [-- <path>...]"
			n=$a
			;;
		esac
	done
	[ -n "$n" ] || die "usage: git salvage restore <n> [--index] [-- <path>...]"
	local ref kind label tip id
	ref=$(ref_for "$n") || exit 1
	id=${ref#"$REF_PREFIX"}
	# By commit id: retention after the pre-restore snapshot may delete $ref.
	ref=$(git rev-parse --verify -q "$ref^{commit}") || die "cannot read snapshot $n"
	kind=$(trailer "$ref" Salvage-Kind)
	case $kind in
	worktree)
		if [ "$with_index" = 1 ] && [ "$(trailer "$ref" Salvage-Index)" != captured ]; then
			die "snapshot $n did not capture the index (it had unmerged entries); restore without --index"
		fi
		# Resolved before this snapshot shifts the numbering.
		snapshot_worktree "restore of $id" 0 ||
			die "could not save the current state first (${SNAP_ERR:-unknown error}); nothing was restored"
		[ "$SAVED" = 1 ] && retention
		local tmp list
		mktmp || die "cannot create a temporary file"
		tmp=$TMP_LAST
		rm -f "$tmp"
		GIT_INDEX_FILE=$tmp git read-tree "$ref:worktree" || die "git read-tree failed"
		if [ ${#paths[@]} -gt 0 ]; then
			# Pathspecs are relative to the caller's cwd, as in git.
			# checkout-index takes no directories, so expand them first.
			mktmp || die "cannot create a temporary file"
			list=$TMP_LAST
			GIT_INDEX_FILE=$tmp git ls-files -z -- "${paths[@]}" >"$list" || die "restore failed"
			[ -s "$list" ] || die "no such path in snapshot $n: ${paths[*]}"
			GIT_INDEX_FILE=$tmp git checkout-index -f -z --stdin <"$list" || die "restore failed"
		else
			# -a only covers the cwd's subtree when run from a subdirectory.
			(cd "$TOP" && GIT_INDEX_FILE=$tmp git checkout-index -f -a) || die "restore failed"
		fi
		if [ "$with_index" = 1 ]; then
			git read-tree "$ref:index" || die "git read-tree of the index failed"
		fi
		[ "$SAVED" = 1 ] && err "the state before this restore was saved as snapshot 1"
		echo "restored snapshot $n"
		;;
	branch)
		label=$(trailer "$ref" Salvage-Ref)
		tip=$(git rev-parse "$ref^1")
		git show-ref -q --verify "$label" && die "$label already exists; not overwriting it"
		git update-ref -m "git-salvage restore" "$label" "$tip" "" || die "git update-ref failed"
		echo "restored $label at $(git rev-parse --short "$tip")"
		;;
	stash)
		tip=$(git rev-parse "$ref^1")
		git stash store -m "$(git log -1 --format=%s "$tip")" "$tip" || die "git stash store failed"
		echo "restored stash entry as stash@{0}"
		;;
	*) die "snapshot $n has an unknown kind '$kind'" ;;
	esac
}

cmd_snapshot() {
	need_repo
	local msg="git salvage snapshot"
	case ${1:-} in
	-m)
		[ $# -ge 2 ] || die "usage: git salvage snapshot [-m <message>]"
		msg=$2
		;;
	'') ;;
	*) die "usage: git salvage snapshot [-m <message>]" ;;
	esac
	snapshot_worktree "$msg" 0 || die "could not save a snapshot (${SNAP_ERR:-unknown error})"
	if [ "$SAVED" = 1 ]; then
		retention
		echo "saved snapshot 1"
	else
		echo "nothing to save"
	fi
}

cmd_drop() {
	need_repo
	[ $# -eq 1 ] || die "usage: git salvage drop <n>"
	local ref
	ref=$(ref_for "$1") || exit 1
	git update-ref -d "$ref" || die "git update-ref failed"
	echo "dropped snapshot $1"
}

cmd_prune() {
	need_repo
	local keep='' days='' ref cutoff t dropped=0
	while [ $# -gt 0 ]; do
		case $1 in
		--keep) keep=${2:-}; shift 2 || die "--keep needs a number" ;;
		--older-than) days=${2:-}; shift 2 || die "--older-than needs a number of days" ;;
		*) die "usage: git salvage prune [--keep <k>] [--older-than <days>]" ;;
		esac
	done
	[ -n "$keep$days" ] || die "usage: git salvage prune [--keep <k>] [--older-than <days>]"
	case $keep in *[!0-9]*) die "--keep needs a number" ;; esac
	case $days in *[!0-9]*) die "--older-than needs a number of days" ;; esac
	local n=0
	[ -n "$days" ] && cutoff=$(($(date +%s) - days * 86400))
	for ref in $(list_refs); do
		n=$((n + 1))
		if [ -n "$keep" ] && [ "$n" -gt "$keep" ]; then
			git update-ref -d "$ref" && dropped=$((dropped + 1))
			continue
		fi
		if [ -n "$days" ]; then
			t=$(git log -1 --format=%ct "$ref")
			if [ "$t" -lt "$cutoff" ]; then
				git update-ref -d "$ref" && dropped=$((dropped + 1))
			fi
		fi
	done
	echo "pruned $dropped snapshot(s)"
}

SHIM_MARKER="git-salvage PATH shim"
DEFAULT_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/git-salvage/bin

# install_dir_arg "$@" -> sets DIR from [--dir <dir>]
install_dir_arg() {
	DIR=$DEFAULT_DIR
	case ${1:-} in
	'') ;;
	--dir)
		[ -n "${2:-}" ] && [ $# -eq 2 ] || die "usage: git salvage $SUB [--dir <dir>]"
		DIR=$2
		;;
	*) die "usage: git salvage $SUB [--dir <dir>]" ;;
	esac
}

is_shim() { [ -f "$1" ] && grep -q "$SHIM_MARKER" "$1" 2>/dev/null; }

# copy_into <src> <dest>: replace dest atomically (a running git may exec it).
copy_into() {
	[ "$1" -ef "$2" ] && return 0
	if ! { cp "$1" "$2.tmp.$$" && mv -f "$2.tmp.$$" "$2"; }; then
		rm -f "$2.tmp.$$"
		die "cannot write $2"
	fi
}

cmd_install() {
	install_dir_arg "$@"
	local self here shim
	self=$0
	here=$(cd -P -- "${self%/*}" && pwd -P) || die "cannot locate $self"
	# From a checkout: ../shim/git. From an installed copy: the git beside it.
	if is_shim "$here/../shim/git"; then
		shim=$here/../shim/git
	elif is_shim "$here/git"; then
		shim=$here/git
	else
		die "cannot find shim/git next to $self"
	fi
	if [ -e "$DIR/git" ] && ! is_shim "$DIR/git"; then
		die "$DIR/git exists and is not the git-salvage shim; not overwriting it"
	fi
	mkdir -p "$DIR" || die "cannot create $DIR"
	# The shim and git-salvage side by side: one PATH entry reaches both.
	copy_into "$shim" "$DIR/git"
	copy_into "$self" "$DIR/git-salvage"
	chmod 755 "$DIR/git" "$DIR/git-salvage" || die "cannot chmod files in $DIR"
	echo "installed $DIR/git and $DIR/git-salvage"
	echo "add this line to your shell profile (then open a new shell):"
	# shellcheck disable=SC2016 # the profile expands $PATH, not us
	printf '  export PATH="%s:$PATH"\n' "$DIR"
}

cmd_uninstall() {
	install_dir_arg "$@"
	if ! [ -e "$DIR/git" ] && ! [ -e "$DIR/git-salvage" ]; then
		echo "nothing installed in $DIR"
		return 0
	fi
	if [ -e "$DIR/git" ]; then
		is_shim "$DIR/git" || die "$DIR/git is not the git-salvage shim; not removing it"
		rm -f "$DIR/git" || die "cannot remove $DIR/git"
	fi
	rm -f "$DIR/git-salvage" || die "cannot remove $DIR/git-salvage"
	rmdir "$DIR" 2>/dev/null
	echo "removed $DIR/git and $DIR/git-salvage"
	echo "remove $DIR from PATH in your shell profile; snapshots stay under refs/salvage/"
}

# The first `git` on the caller's PATH. git put its exec-path in front of PATH
# before running us (measured), so that entry is skipped.
first_git_on_path() { # [<skip-dir>] -> prints path
	local skip=${1:-} execdir d IFS=:
	execdir=$(git --exec-path 2>/dev/null)
	set -f
	for d in $PATH; do
		[ -n "$d" ] || d=.
		[ "$d" = "$execdir" ] && continue
		[ -n "$skip" ] && [ "$(cd -P -- "$d" 2>/dev/null && pwd -P)" = "$skip" ] && continue
		if [ -f "$d/git" ] && [ -x "$d/git" ]; then
			set +f
			printf '%s\n' "$d/git"
			return 0
		fi
	done
	set +f
	return 1
}

cmd_doctor() {
	local first shimdir real problems=0
	echo "git-salvage: $0"
	if first=$(first_git_on_path); then
		echo "first git on PATH: $first"
	else
		echo "first git on PATH: none"
		problems=1
	fi
	if [ -n "$first" ] && is_shim "$first"; then
		echo "it is the git-salvage shim: yes"
		if [ -n "${GIT_SALVAGE_REAL_GIT:-}" ]; then
			real=$GIT_SALVAGE_REAL_GIT
			echo "real git (GIT_SALVAGE_REAL_GIT): $real"
		else
			shimdir=$(cd -P -- "${first%/*}" && pwd -P)
			real=$(first_git_on_path "$shimdir") || real=
			echo "real git: ${real:-NOT FOUND}"
		fi
		if [ -n "$real" ] && [ -x "$real" ]; then
			echo "real git version: $("$real" --version)"
		else
			problems=1
		fi
	else
		echo "it is the git-salvage shim: NO -- destructive commands are not protected"
		echo "  (run: git salvage install, and put its directory first on PATH)"
		problems=1
	fi
	[ "${GIT_SALVAGE_SKIP:-}" = 1 ] && { echo "GIT_SALVAGE_SKIP=1 is set: snapshots are OFF"; problems=1; }
	if repo_setup; then
		echo "snapshots in this repo: $(list_refs | wc -l | tr -d ' ')"
	else
		echo "not inside a git work tree"
	fi
	return "$problems"
}

# ----------------------------------------------------------------------- main

main() {
	SUB=${1:-}
	local sub=$SUB
	[ $# -gt 0 ] && shift
	case $sub in
	_pre) cmd_pre "$@" ;;
	list) cmd_list "$@" ;;
	show) cmd_show "$@" ;;
	restore) cmd_restore "$@" ;;
	snapshot) cmd_snapshot "$@" ;;
	drop) cmd_drop "$@" ;;
	prune) cmd_prune "$@" ;;
	install) cmd_install "$@" ;;
	uninstall) cmd_uninstall "$@" ;;
	doctor) cmd_doctor "$@" ;;
	-h | --help | help)
		usage
		return 0
		;;
	'')
		usage >&2
		return 1
		;;
	*)
		err "unknown subcommand: $sub"
		usage >&2
		return 1
		;;
	esac
}

main "$@"
